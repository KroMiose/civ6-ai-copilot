{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civ6-ai-copilot.local/schemas/snapshot.schema.json",
  "title": "civ6-ai-copilot player-visible snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "exportedAt",
    "source",
    "session",
    "localPlayer",
    "modules",
    "cities",
    "units",
    "visibleMap",
    "techs",
    "civics",
    "government",
    "resources",
    "diplomacy",
    "attention",
    "confidence",
    "moduleStatus",
    "selection",
    "governors",
    "trade",
    "cityStates"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.3.0" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["modId", "modVersion", "compatVersion", "transport", "visibilityMode", "protocolVersion", "exportId"],
      "additionalProperties": false,
      "properties": {
        "modId": { "type": "string", "const": "civ6-ai-copilot" },
        "modVersion": { "type": "string" },
        "compatVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "transport": { "type": "string", "enum": ["lua-log"] },
        "visibilityMode": { "type": "string", "const": "player-visible" },
        "exportId": { "type": "string" },
        "exportType": { "type": "string", "enum": ["turn", "full", "modules", "map-window", "visible-map", "diagnostic"] },
        "protocolVersion": { "type": "string", "const": "0.3.0" }
      }
    },
    "session": {
      "type": "object",
      "required": ["sessionId", "gameTurn", "ruleset", "gameSpeed", "mapSize", "isMultiplayer", "idScope"],
      "additionalProperties": false,
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "gameTurn": { "type": "integer", "minimum": 0 },
        "ruleset": { "type": "string" },
        "gameSpeed": { "type": "string" },
        "mapSize": { "type": "string" },
        "humanPlayerCount": { "type": "integer", "minimum": 0 },
        "isMultiplayer": { "type": "boolean" },
        "idScope": { "type": "string", "enum": ["load"] }
      }
    },
    "localPlayer": { "$ref": "#/$defs/playerSummary" },
    "modules": {
      "type": "array",
      "items": { "type": "string", "enum": ["meta", "localPlayer", "selection", "cities", "units", "governors", "trade", "cityStates", "techs", "civics", "government", "policies", "resources", "diplomacyPublic", "visibleMap", "economy"] },
      "uniqueItems": true
    },
    "selection": { "$ref": "#/$defs/selection" },
    "cities": {
      "type": "array",
      "items": { "$ref": "#/$defs/city" }
    },
    "units": {
      "type": "array",
      "items": { "$ref": "#/$defs/unit" }
    },
    "governors": { "$ref": "#/$defs/governors" },
    "trade": { "$ref": "#/$defs/trade" },
    "cityStates": { "$ref": "#/$defs/cityStates" },
    "visibleMap": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "tiles"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "$ref": "#/$defs/visibilityKind" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "scope": { "type": "string", "enum": ["player-visible-revealed"] },
        "truncated": { "type": "boolean" },
        "tileLimit": { "type": "integer", "minimum": 1 },
        "revealedTileCount": { "type": "integer", "minimum": 0 },
        "worldIndex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "truncated": { "type": "boolean" },
            "cities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "integer" },
                  "y": { "type": "integer" },
                  "ownerPlayerId": { "type": "integer" },
                  "name": { "type": "string" }
                }
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "resourceType"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "integer" },
                  "y": { "type": "integer" },
                  "resourceType": { "type": "string" }
                }
              }
            }
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minX": { "type": "integer" },
            "maxX": { "type": "integer" },
            "minY": { "type": "integer" },
            "maxY": { "type": "integer" }
          }
        },
        "tiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/tile" }
        }
      }
    },
    "techs": { "$ref": "#/$defs/progression" },
    "civics": { "$ref": "#/$defs/progression" },
    "government": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "currentGovernment", "policySlots", "policies"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "$ref": "#/$defs/visibilityKind" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "currentGovernment": { "$ref": "#/$defs/namedType" },
        "policySlots": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/$defs/namedType" }
        },
        "canChangePolicies": { "type": "boolean" },
        "availablePolicies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" },
              "slotType": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "items"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "$ref": "#/$defs/visibilityKind" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "amount"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" },
              "amount": { "type": "number" }
            }
          }
        }
      }
    },
    "diplomacy": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "metPlayers"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "$ref": "#/$defs/visibilityKind" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "metPlayers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["playerId", "civilizationType", "relationship"],
            "additionalProperties": false,
            "properties": {
              "playerId": { "type": "integer" },
              "civilizationType": { "type": "string" },
              "leaderType": { "type": "string" },
              "relationship": { "type": "string" },
              "militaryScore": { "type": "number" },
              "visibility": { "$ref": "#/$defs/visibilityKind" },
              "source": { "$ref": "#/$defs/sourceKind" },
              "confidence": { "$ref": "#/$defs/confidenceKind" }
            }
          }
        }
      }
    },
    "attention": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "message", "severity", "source", "visibility", "confidence"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "urgent"] },
          "source": { "$ref": "#/$defs/sourceKind" },
          "visibility": { "$ref": "#/$defs/visibilityKind" },
          "confidence": { "$ref": "#/$defs/confidenceKind" }
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["overall"],
      "additionalProperties": { "$ref": "#/$defs/confidenceKind" },
      "properties": {
        "overall": { "$ref": "#/$defs/confidenceKind" }
      }
    },
    "extensions": { "type": "object", "additionalProperties": true },
    "moduleStatus": {
      "type": "object",
      "propertyNames": { "enum": ["meta", "localPlayer", "selection", "cities", "units", "governors", "trade", "cityStates", "techs", "civics", "government", "policies", "resources", "diplomacyPublic", "visibleMap", "economy"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capturedTurn", "capturedAt", "exportId"],
        "properties": {
          "capturedTurn": { "type": "integer", "minimum": 0 },
          "capturedAt": { "type": "string", "format": "date-time" },
          "exportId": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "enum": ["own-only", "own-and-visible"] }
        }
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "visibility", "confidence"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "const": "own", "type": "string" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "sciencePerTurn": { "type": "number" },
        "culturePerTurn": { "type": "number" },
        "faithPerTurn": { "type": "number" },
        "goldPerTurn": { "type": "number" },
        "goldBalance": { "type": "number" },
        "faithBalance": { "type": "number" },
        "goldIncomePerTurn": { "type": "number" },
        "goldMaintenancePerTurn": { "type": "number" }
      }
    }
  },
  "$defs": {
    "sourceKind": { "type": "string", "enum": ["lua-api", "ui-derived", "gameinfo-static", "inferred", "fixture"] },
    "visibilityKind": { "type": "string", "enum": ["own", "visible-now", "revealed", "public-known", "player-visible"] },
    "confidenceKind": { "type": "string", "enum": ["confirmed", "inferred", "low"] },
    "namedType": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "districtFact": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "isBuilt": { "type": "boolean" }
      }
    },
    "playerSummary": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "localPlayerId", "civilizationType", "leaderType"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "$ref": "#/$defs/visibilityKind" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "localPlayerId": { "type": "integer", "minimum": 0 },
        "civilizationType": { "type": "string" },
        "leaderType": { "type": "string" },
        "isHuman": { "type": "boolean" }
      }
    },
    "city": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "id", "name", "ownerPlayerId", "x", "y", "population"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "$ref": "#/$defs/visibilityKind" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerPlayerId": { "type": "integer" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "population": { "type": "integer", "minimum": 1 },
        "currentProduction": { "$ref": "#/$defs/namedType" },
        "turnsUntilComplete": { "type": "integer", "minimum": 0 },
        "yields": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "housing": { "type": "number" },
        "amenities": { "type": "number" },
        "amenitiesNeeded": { "type": "number" },
        "turnsUntilGrowth": { "type": "integer", "minimum": 0 },
        "turnsUntilStarvation": { "type": "integer", "minimum": 0 },
        "buildings": { "type": "array", "items": { "$ref": "#/$defs/namedType" } },
        "districts": { "type": "array", "items": { "$ref": "#/$defs/districtFact" } },
        "populationLimitedDistrictsUsed": { "type": "integer", "minimum": 0 },
        "populationLimitedDistrictsCapacity": { "type": "integer", "minimum": 0 },
        "currentProductionProgress": { "type": "number", "minimum": 0 },
        "currentProductionCost": { "type": "number", "minimum": 0 },
        "foodStock": { "type": "number", "minimum": 0 },
        "foodSurplus": { "type": "number" },
        "growthThreshold": { "type": "number", "minimum": 0 },
        "underSiege": { "type": "boolean" }
      }
    },
    "unit": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "id", "type", "ownerPlayerId", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "$ref": "#/$defs/visibilityKind" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "ownerPlayerId": { "type": "integer" },
        "originalOwnerPlayerId": { "type": "integer", "minimum": 0 },
        "isLevied": { "type": "boolean" },
        "levyTurnsRemaining": { "type": "integer", "minimum": 0 },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "damage": { "type": "integer", "minimum": 0 },
        "movesRemaining": { "type": "number", "minimum": 0 },
        "formationClass": { "type": "string" },
        "combatStrength": { "type": "number", "minimum": 0 },
        "rangedStrength": { "type": "number", "minimum": 0 },
        "bombardStrength": { "type": "number", "minimum": 0 },
        "range": { "type": "number", "minimum": 0 },
        "maxMoves": { "type": "number", "minimum": 0 },
        "buildCharges": { "type": "integer", "minimum": 0 },
        "experience": { "type": "number", "minimum": 0 },
        "experienceForNextLevel": { "type": "number", "minimum": 0 },
        "level": { "type": "integer", "minimum": 0 },
        "promotions": { "type": "array", "items": { "$ref": "#/$defs/namedType" } },
        "militaryFormation": { "type": "string", "enum": ["standard", "corps", "army"] },
        "upgradeCost": { "type": "number", "minimum": 0 }
      }
    },
    "tile": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "x", "y", "revealed", "visibleNow"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "$ref": "#/$defs/visibilityKind" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "revealed": { "type": "boolean" },
        "visibleNow": { "type": "boolean" },
        "terrainType": { "type": "string" },
        "featureType": { "type": "string" },
        "resourceType": { "type": "string" },
        "resourceAmount": { "type": "integer", "minimum": 0 },
        "improvementType": { "type": "string" },
        "routeType": { "type": "string" },
        "districtType": { "type": "string" },
        "continentType": { "type": "string" },
        "isWater": { "type": "boolean" },
        "isLake": { "type": "boolean" },
        "isCoastalLand": { "type": "boolean" },
        "isFreshWater": { "type": "boolean" },
        "isRiver": { "type": "boolean" },
        "isHills": { "type": "boolean" },
        "isMountain": { "type": "boolean" },
        "isImpassable": { "type": "boolean" },
        "isNaturalWonder": { "type": "boolean" },
        "riverEdges": {
          "type": "array",
          "items": { "type": "string", "enum": ["W", "NW", "NE"] },
          "uniqueItems": true
        },
        "cliffEdges": {
          "type": "array",
          "items": { "type": "string", "enum": ["W", "NW", "NE"] },
          "uniqueItems": true
        },
        "appeal": { "type": "number" },
        "yields": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "ownerPlayerId": { "type": "integer" },
        "cityId": { "type": "string" },
        "unitIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "progression": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "current", "completed", "available"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "$ref": "#/$defs/visibilityKind" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "current": { "$ref": "#/$defs/namedType" },
        "completed": {
          "type": "array",
          "items": { "$ref": "#/$defs/namedType" }
        },
        "available": {
          "type": "array",
          "items": { "$ref": "#/$defs/namedType" }
        },
        "boosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "boosted"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "boosted": { "type": "boolean" },
              "confidence": { "$ref": "#/$defs/confidenceKind" }
            }
          }
        },
        "currentProgress": { "type": "number", "minimum": 0 },
        "currentCost": { "type": "number", "minimum": 0 }
      }
    },
    "availability": { "type": "string", "enum": ["available", "not-applicable", "unavailable"] },
    "selection": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "city", "unit"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "const": "own", "type": "string" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "city": { "$ref": "#/$defs/selectionEntity" },
        "unit": { "$ref": "#/$defs/selectionEntity" }
      }
    },
    "selectionEntity": {
      "type": "object",
      "required": ["status", "id"],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "status": { "const": "selected" },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "properties": {
            "status": { "enum": ["none", "unsupported", "error"] },
            "id": { "type": "null" }
          }
        }
      ],
      "properties": {
        "status": { "type": "string", "enum": ["selected", "none", "unsupported", "error"] },
        "id": { "type": ["string", "null"] }
      }
    },
    "governors": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "availability"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "const": "player-visible", "type": "string" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "availability": { "$ref": "#/$defs/availability" },
        "titlesAvailable": { "type": "integer", "minimum": 0 },
        "titlesSpent": { "type": "integer", "minimum": 0 },
        "canAppoint": { "type": "boolean" },
        "governors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" },
              "title": { "type": "string" },
              "appointed": { "type": "boolean" },
              "assigned": { "type": "boolean" },
              "assignedCityId": { "type": "string" },
              "assignedCityName": { "type": "string" },
              "established": { "type": "boolean" },
              "turnsToEstablish": { "type": "integer", "minimum": 0 },
              "turnsUntilEstablished": { "type": "integer", "minimum": 0 },
              "neutralizedTurns": { "type": "integer", "minimum": 0 },
              "status": { "type": "string", "enum": ["needs-assignment", "transitioning", "established", "neutralized"] },
              "promotions": { "type": "array", "items": { "$ref": "#/$defs/namedType" } }
            }
          }
        }
      }
    },
    "trade": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "availability"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "const": "player-visible", "type": "string" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "availability": { "$ref": "#/$defs/availability" },
        "capacity": { "type": "integer", "minimum": 0 },
        "activeCount": { "type": "integer", "minimum": 0 },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "originCityId": { "type": "string" },
              "originCityName": { "type": "string" },
              "destinationCityId": { "type": "string" },
              "destinationCityName": { "type": "string" },
              "turnsRemaining": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "cityStates": {
      "type": "object",
      "required": ["source", "visibility", "confidence", "availability"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/sourceKind" },
        "visibility": { "const": "player-visible", "type": "string" },
        "confidence": { "$ref": "#/$defs/confidenceKind" },
        "availability": { "$ref": "#/$defs/availability" },
        "availableEnvoys": { "type": "integer", "minimum": 0 },
        "cityStates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["playerId", "type"],
            "additionalProperties": false,
            "properties": {
              "playerId": { "type": "integer", "minimum": 0 },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "envoys": { "type": "integer", "minimum": 0 },
              "isSuzerain": { "type": "boolean" },
              "suzerainPlayerId": { "type": "integer", "minimum": 0 },
              "rewards": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "oneEnvoy": { "type": "string" },
                  "threeEnvoys": { "type": "string" },
                  "sixEnvoys": { "type": "string" },
                  "suzerain": { "type": "string" }
                }
              },
              "quests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "turnsRemaining": { "type": "integer", "minimum": 0 },
                    "reward": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
